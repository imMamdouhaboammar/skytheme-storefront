{
  "name": "skytheme-storefront",
  "version": "1.2.0",
  "description": "Reference-guided storefront implementation skill and verified standalone HTML preview; Shopify Liquid starter scaffold provided separately.",
  "author": "Mamdouh Aboammar",
  "license": "MIT",
  "main": "SKILL.md",
  "bin": {
    "skytheme-storefront": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imMamdouhaboammar/skytheme-storefront.git"
  },
  "homepage": "https://github.com/imMamdouhaboammar/skytheme-storefront#readme",
  "bugs": {
    "url": "https://github.com/imMamdouhaboammar/skytheme-storefront/issues"
  },
  "files": [
    "SKILL.md",
    "bin",
    "scripts",
    "references",
    "assets",
    "agents",
    "evals",
    "marketplace.json",
    ".skills.json",
    "install.sh",
    "README.md",
    "references/clean-room-toolchain.md",
    "scripts/support-tools.mjs",
    "scripts/clean-room.mjs",
    "scripts/capture-motion.mjs",
    "scripts/setup-spector.mjs",
    "tests"
  ],
  "scripts": {
    "eval": "bun scripts/run-evals.ts",
    "test": "bun scripts/run-evals.ts && playwright test",
    "generate": "bun scripts/generate-storefront.ts",
    "validate": "bun scripts/validate-storefront.ts",
    "test:browser": "playwright test",
    "generate:shopify": "bun scripts/generate-shopify-theme.ts",
    "test:toolchain": "node --test tests/support-tools.test.mjs tests/clean-room.test.mjs tests/capture-motion.test.mjs tests/spector.test.mjs",
    "tools:doctor": "node scripts/support-tools.mjs doctor --json",
    "tools:plan": "node scripts/support-tools.mjs plan",
    "tools:install": "node scripts/support-tools.mjs install",
    "tools:mcp": "node scripts/support-tools.mjs mcp-config",
    "spector:doctor": "node scripts/setup-spector.mjs doctor",
    "spector:plan": "node scripts/setup-spector.mjs plan",
    "spector:install": "node scripts/setup-spector.mjs install",
    "clean-room:init": "node scripts/clean-room.mjs init",
    "clean-room:audit": "node scripts/clean-room.mjs audit",
    "motion:capture": "node scripts/capture-motion.mjs"
  },
  "keywords": [
    "agent-skill",
    "ecommerce",
    "shopify-theme",
    "skytheme",
    "luxury-fashion",
    "storefront",
    "lenis",
    "gsap",
    "motion",
    "lookbook",
    "cart-drawer",
    "web-components",
    "skills-sh",
    "claude-code",
    "cursor"
  ],
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "type": "module"
}
